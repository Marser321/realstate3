    "@types/leaflet": "^1.9.21",
    "@vercel/og": "^0.8.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.33.0",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.17",
    "lucide-react": "^0.563.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.0.0",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "stripe": "^20.3.1",
    "swiper": "^12.1.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
